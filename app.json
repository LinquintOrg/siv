{
  "expo": {
    "name": "Steam Inventory Value",
    "slug": "siv",
    "version": "5.0.0",
    "orientation": "default",
    "icon": "./assets/icons/siv.png",
    "scheme": "siv",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.rsds.steaminventoryvalue",
      "versionCode": 2010000187,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/siv-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#091b53"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9ee78a6c-9709-416e-baf5-905247436ac4"
      }
    }
  }
}
