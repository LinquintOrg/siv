{
  "cli": {
    "version": ">= 3.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "buildArtifactPaths": [ "android/app/build/outputs/mapping/release/mapping.txt" ],
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.linquint.dev",
        "EXPO_PUBLIC_MUSIC_URL": "https://api.linquint.dev/music"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
